<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<HBox xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.PorteurProjetFormController"
      prefHeight="820" prefWidth="1320"
      style="-fx-background-color:#F8FAFC;"
            stylesheets="@../themes/app-base.css">

  <!-- ═══ SIDEBAR ═══ -->
  <VBox prefWidth="240" minWidth="240" maxWidth="240" spacing="0"
        style="-fx-background-color:#0F172A;">
    <VBox style="-fx-padding:22 18 18 18;-fx-spacing:4;-fx-border-color:rgba(255,255,255,0.1);-fx-border-width:0 0 1 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="GL" style="-fx-background-color:#059669;-fx-text-fill:white;-fx-font-size:13px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:36;-fx-min-height:36;-fx-max-width:36;-fx-max-height:36;-fx-alignment:CENTER;"/>
        <VBox spacing="1">
          <Label text="GreenLedger" style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:white;"/>
          <Label text="Porteur de Projet" style="-fx-font-size:9px;-fx-text-fill:rgba(16,185,129,0.75);-fx-font-weight:600;"/>
        </VBox>
      </HBox>
    </VBox>
    <VBox style="-fx-padding:16 14 6 14;">
      <Label text="NAVIGATION" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:rgba(255,255,255,0.25);"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Tableau de bord" onAction="#onDashboard"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Mes projets" onAction="#onProjets"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Nouveau projet" onAction="#onBack"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:#059669;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;-fx-effect:dropshadow(gaussian,rgba(5,150,105,0.35),12,0,0,3);"/>
      <Button text="  Mes évaluations" onAction="#onEvaluations"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Financement" onAction="#onFinancing"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
    </VBox>
    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="COMMUNICATION" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:rgba(255,255,255,0.25);"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Messages" onAction="#onMessages"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Assistant IA" onAction="#onAssistant"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
    </VBox>
    <Region VBox.vgrow="ALWAYS"/>
    <VBox style="-fx-background-color:#070F1A;-fx-padding:14;-fx-spacing:10;-fx-border-color:rgba(255,255,255,0.1);-fx-border-width:1 0 0 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="P" style="-fx-background-color:#059669;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:800;-fx-background-radius:20;-fx-min-width:38;-fx-min-height:38;-fx-max-width:38;-fx-max-height:38;-fx-alignment:CENTER;"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="lblProfileName" style="-fx-font-size:12px;-fx-font-weight:700;-fx-text-fill:white;"/>
          <Label fx:id="lblProfileType" style="-fx-font-size:9px;-fx-text-fill:rgba(16,185,129,0.6);"/>
        </VBox>
      </HBox>
      <HBox spacing="6">
        <Button text="Profil" onAction="#onEditProfile" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color:#1E293B;-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
        <Button text="Quitter" onAction="#onLogout"
                style="-fx-background-color:rgba(244,63,94,0.15);-fx-text-fill:#f43f5e;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-color:rgba(244,63,94,0.3);-fx-border-width:1;-fx-background-insets:0;"/>
      </HBox>
    </VBox>
  </VBox>

  <!-- ═══ MAIN CONTENT (original BorderPane content) ═══ -->
  <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color:#F8FAFC;">
    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color:white;-fx-padding:12 24;-fx-border-color:#E2E8F0;-fx-border-width:0 0 1 0;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
      <Button text="Retour" onAction="#onBack"
              style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-padding:9 16;-fx-cursor:hand;-fx-background-insets:0;"/>
      <Label fx:id="lblFormTitle" text="Nouveau Projet"
             style="-fx-font-size:17px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="lblCompletenessScore" text=""
             style="-fx-font-size:12px;-fx-font-weight:700;-fx-text-fill:#059669;"/>
      <Button fx:id="btnSubmit" text="Soumettre pour evaluation" onAction="#onSubmit"
              style="-fx-background-color:#F59E0B;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:9 20;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"
              visible="false" managed="false"/>
      <Button text="Sauvegarder" onAction="#onSave"
              style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:9 20;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;-fx-effect:dropshadow(gaussian,rgba(5,150,105,0.18),12,0,0,4);"/>
    </HBox>
    <!-- Center: form + live panel -->
    <HBox spacing="0" VBox.vgrow="ALWAYS" style="-fx-background-color:#F8FAFC;">

      <!-- LEFT: scrollable form -->
      <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                  style="-fx-background:#F8FAFC;-fx-background-color:#F8FAFC;">
        <VBox spacing="18">
          <padding><Insets top="28" right="28" bottom="32" left="28"/></padding>

          <!-- Completeness bar -->
          <VBox spacing="8"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label text="Completude du dossier"
                     style="-fx-font-size:12px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblCompletePct" text="0%"
                     style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:#2D5F3F;"/>
            </HBox>
            <ProgressBar fx:id="progressCompleteness" progress="0" maxWidth="Infinity"
                         style="-fx-accent:#2D5F3F;-fx-pref-height:10;-fx-background-color:#E2E8F0;-fx-background-radius:5;"/>
            <Label fx:id="lblMissingFields" text=""
                   style="-fx-font-size:10px;-fx-text-fill:#94A3B8;" wrapText="true"/>
          </VBox>

          <!-- Section 1: Informations generales -->
          <VBox spacing="14"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label text="1"
                     style="-fx-background-color:#2D5F3F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:800;-fx-background-radius:14;-fx-min-width:24;-fx-min-height:24;-fx-alignment:CENTER;"/>
              <Label text="Informations generales"
                     style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            </HBox>
            <VBox spacing="5">
              <Label text="Titre du projet *"
                     style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
              <TextField fx:id="txtTitre" promptText="Ex: Centrale solaire 500kW Sfax"
                         style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
            </VBox>
            <VBox spacing="5">
              <Label text="Description *"
                     style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
              <TextArea fx:id="txtDescription" promptText="Decrivez votre projet, son impact environnemental et ses objectifs..."
                        prefHeight="90" wrapText="true"
                        style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
            </VBox>
          </VBox>

          <!-- Section 2: Contact -->
          <VBox spacing="14"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label text="2"
                     style="-fx-background-color:#2D5F3F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:800;-fx-background-radius:14;-fx-min-width:24;-fx-min-height:24;-fx-alignment:CENTER;"/>
              <Label text="Contact et Entreprise"
                     style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            </HBox>
            <GridPane hgap="14" vgap="12">
              <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Adresse *" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <TextField fx:id="txtAddress" promptText="Adresse complete"
                           style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Email *" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <TextField fx:id="txtEmail" promptText="email@exemple.com"
                           style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Telephone *" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <TextField fx:id="txtPhone" promptText="+216 XX XXX XXX"
                           style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Localisation" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <TextField fx:id="txtLocalisation" promptText="Ville, Pays"
                           style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
              </VBox>
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
              </columnConstraints>
            </GridPane>
          </VBox>

          <!-- Section 3: Classification -->
          <VBox spacing="14"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label text="3"
                     style="-fx-background-color:#2D5F3F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:800;-fx-background-radius:14;-fx-min-width:24;-fx-min-height:24;-fx-alignment:CENTER;"/>
              <Label text="Classification"
                     style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            </HBox>
            <GridPane hgap="14" vgap="12">
              <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Secteur" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <ComboBox fx:id="cmbSecteur" maxWidth="Infinity" style="-fx-font-size:13px;"/>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Type de projet" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <ComboBox fx:id="cmbTypeProjet" maxWidth="Infinity" style="-fx-font-size:13px;"/>
              </VBox>
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
              </columnConstraints>
            </GridPane>
          </VBox>

          <!-- Section 4: Donnees environnementales -->
          <VBox spacing="14"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label text="4"
                     style="-fx-background-color:#2D5F3F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:800;-fx-background-radius:14;-fx-min-width:24;-fx-min-height:24;-fx-alignment:CENTER;"/>
              <Label text="Donnees environnementales"
                     style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
              <Label text="Impact sur le score ESG"
                     style="-fx-font-size:10px;-fx-text-fill:#2D5F3F;-fx-padding:2 8;-fx-background-color:#D1FAE5;-fx-background-radius:4;"/>
            </HBox>
            <GridPane hgap="14" vgap="12">
              <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Consommation energie" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <HBox spacing="6">
                  <TextField fx:id="txtEnergie" promptText="0.0" HBox.hgrow="ALWAYS"
                             style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
                  <ComboBox fx:id="cmbUniteEnergie" prefWidth="80" style="-fx-font-size:12px;"/>
                </HBox>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Distance transport (km)" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <HBox spacing="6">
                  <TextField fx:id="txtTransport" promptText="0.0" HBox.hgrow="ALWAYS"
                             style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
                  <ComboBox fx:id="cmbTypeTransport" prefWidth="100" style="-fx-font-size:12px;"/>
                </HBox>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Quantite materiau (kg)" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <HBox spacing="6">
                  <TextField fx:id="txtMateriau" promptText="0.0" HBox.hgrow="ALWAYS"
                             style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
                  <ComboBox fx:id="cmbTypeMateriau" prefWidth="100" style="-fx-font-size:12px;"/>
                </HBox>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Consommation eau (L)" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <TextField fx:id="txtEau" promptText="0.0"
                           style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Dechets generes (kg)" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <TextField fx:id="txtDechets" promptText="0.0"
                           style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
              </VBox>
              <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Emissions estimees (tCO2e)" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
                <HBox spacing="6">
                  <TextField fx:id="txtEmissions" promptText="0.0" HBox.hgrow="ALWAYS"
                             style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
                  <ComboBox fx:id="cmbSourceEmissions" prefWidth="110" style="-fx-font-size:12px;"/>
                </HBox>
              </VBox>
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
              </columnConstraints>
            </GridPane>
          </VBox>

          <!-- Section 5: Financement -->
          <VBox spacing="14"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label text="5"
                     style="-fx-background-color:#2D5F3F;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:800;-fx-background-radius:14;-fx-min-width:24;-fx-min-height:24;-fx-alignment:CENTER;"/>
              <Label text="Financement"
                     style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            </HBox>
            <VBox spacing="5">
              <Label text="Montant demande (TND)" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
              <TextField fx:id="txtMontant" promptText="0.00"
                         style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
            </VBox>
            <VBox spacing="5">
              <Label text="Pitch investisseur" style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#374151;"/>
              <TextArea fx:id="txtPitch" promptText="Decrivez votre projet pour les investisseurs..."
                        prefHeight="80" wrapText="true"
                        style="-fx-font-size:13px;-fx-background-color:#F8FAFC;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:#CBD5E1;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;"/>
            </VBox>
          </VBox>

          <!-- Error label -->
          <Label fx:id="lblError" text="" wrapText="true"
                 style="-fx-text-fill:#DC2626;-fx-font-size:12px;-fx-font-weight:600;"/>

          <!-- Bottom action row -->
          <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding:0 0 8 0;">
            <Button text="Annuler" onAction="#onBack"
                    style="-fx-background-color:white;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:10 22;-fx-cursor:hand;-fx-border-color:#CBD5E1;-fx-border-width:1;"/>
            <Button fx:id="btnSubmitBottom" text="Soumettre pour evaluation" onAction="#onSubmit"
                    style="-fx-background-color:#F59E0B;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:10 22;-fx-cursor:hand;"
                    visible="false" managed="false"/>
            <Button text="Sauvegarder le projet" onAction="#onSave"
                    style="-fx-background-color:#2D5F3F;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:10 22;-fx-cursor:hand;-fx-effect:dropshadow(gaussian,rgba(45,95,63,0.3),6,0,0,2);"/>
          </HBox>
        </VBox>
      </ScrollPane>

      <!-- RIGHT: live preview panel -->
      <VBox prefWidth="340" spacing="0"
            style="-fx-background-color:#111827;-fx-border-color:#1F2937;-fx-border-width:0 0 0 1;">
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background:#111827;-fx-background-color:#111827;">
          <VBox spacing="16">
            <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>

            <!-- Panel title -->
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Analyse en temps reel"
                     style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:white;"/>
              <Label text="LIVE"
                     style="-fx-background-color:#2D5F3F;-fx-text-fill:#6EE7B7;-fx-font-size:8px;-fx-font-weight:800;-fx-background-radius:4;-fx-padding:2 6;"/>
            </HBox>

            <!-- ESG Score prediction card -->
            <VBox spacing="10"
                  style="-fx-background-color:#1A2E26;-fx-border-color:#2D5F3F;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 18;">
              <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Score ESG Predit"
                       style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#6EE7B7;"/>
                <Label text="ML"
                       style="-fx-background-color:rgba(110,231,183,0.15);-fx-text-fill:#6EE7B7;-fx-font-size:8px;-fx-font-weight:700;-fx-background-radius:3;-fx-padding:1 5;"/>
              </HBox>
              <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="lblEsgScore" text="—"
                       style="-fx-font-size:42px;-fx-font-weight:800;-fx-text-fill:#6EE7B7;"/>
                <VBox spacing="2">
                  <Label text="/ 10" style="-fx-font-size:14px;-fx-text-fill:rgba(255,255,255,0.4);"/>
                  <Label fx:id="lblEsgDecision" text=""
                         style="-fx-font-size:10px;-fx-font-weight:700;-fx-background-radius:4;-fx-padding:2 7;"/>
                </VBox>
              </HBox>
              <ProgressBar fx:id="progressEsg" progress="0" maxWidth="Infinity"
                           style="-fx-accent:#6EE7B7;-fx-pref-height:6;-fx-background-color:rgba(255,255,255,0.08);-fx-background-radius:3;"/>
              <Label fx:id="lblEsgDetail" text="Remplissez les donnees environnementales"
                     style="-fx-font-size:10px;-fx-text-fill:rgba(255,255,255,0.4);" wrapText="true"/>
            </VBox>

            <!-- Carbon emissions card -->
            <VBox spacing="10"
                  style="-fx-background-color:#1F2937;-fx-border-color:#374151;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 18;">
              <Label text="Emissions Carbone Estimees"
                     style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#9CA3AF;"/>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="lblTotalTco2" text="—"
                       style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:white;"/>
                <Label text="tCO2e" style="-fx-font-size:12px;-fx-text-fill:rgba(255,255,255,0.4);-fx-padding:8 0 0 0;"/>
              </HBox>
              <VBox spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label text="Scope 1" style="-fx-font-size:10px;-fx-text-fill:#9CA3AF;-fx-min-width:55;"/>
                  <Label fx:id="lblScope1" text="—" style="-fx-font-size:11px;-fx-font-weight:600;-fx-text-fill:white;"/>
                  <Label text="tCO2e" style="-fx-font-size:9px;-fx-text-fill:rgba(255,255,255,0.3);"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label text="Scope 2" style="-fx-font-size:10px;-fx-text-fill:#9CA3AF;-fx-min-width:55;"/>
                  <Label fx:id="lblScope2" text="—" style="-fx-font-size:11px;-fx-font-weight:600;-fx-text-fill:white;"/>
                  <Label text="tCO2e" style="-fx-font-size:9px;-fx-text-fill:rgba(255,255,255,0.3);"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label text="Scope 3" style="-fx-font-size:10px;-fx-text-fill:#9CA3AF;-fx-min-width:55;"/>
                  <Label fx:id="lblScope3" text="—" style="-fx-font-size:11px;-fx-font-weight:600;-fx-text-fill:white;"/>
                  <Label text="tCO2e" style="-fx-font-size:9px;-fx-text-fill:rgba(255,255,255,0.3);"/>
                </HBox>
              </VBox>
            </VBox>

            <!-- Green credits card -->
            <VBox spacing="10"
                  style="-fx-background-color:#1A2E26;-fx-border-color:#2D5F3F;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 18;">
              <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Credits Verts Potentiels"
                       style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#6EE7B7;"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="lblGreenCredits" text="—"
                       style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#6EE7B7;"/>
                <Label text="credits" style="-fx-font-size:12px;-fx-text-fill:rgba(110,231,183,0.5);-fx-padding:8 0 0 0;"/>
              </HBox>
              <Label fx:id="lblCreditsDetail" text="Basé sur les emissions evitees"
                     style="-fx-font-size:10px;-fx-text-fill:rgba(255,255,255,0.35);" wrapText="true"/>
            </VBox>

            <!-- Carbon risk badge -->
            <VBox spacing="8"
                  style="-fx-background-color:#1F2937;-fx-border-color:#374151;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:14 18;">
              <Label text="Risque Carbone"
                     style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#9CA3AF;"/>
              <Label fx:id="lblCarbonRisk" text="—"
                     style="-fx-font-size:16px;-fx-font-weight:800;-fx-text-fill:white;"/>
            </VBox>

            <!-- AI Assistant -->
            <VBox spacing="10"
                  style="-fx-background-color:#1E3A5F;-fx-border-color:#2563EB;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 18;">
              <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Assistant IA"
                       style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#93C5FD;"/>
                <Label text="OpenRouter"
                       style="-fx-background-color:rgba(37,99,235,0.3);-fx-text-fill:#93C5FD;-fx-font-size:8px;-fx-font-weight:700;-fx-background-radius:3;-fx-padding:1 5;"/>
              </HBox>
              <HBox spacing="8">
                <TextField fx:id="txtAiQuestion" promptText="Posez une question..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size:12px;-fx-background-color:white;-fx-text-fill:#0F172A;-fx-prompt-text-fill:#94A3B8;-fx-border-color:rgba(37,99,235,0.4);-fx-border-radius:7;-fx-background-radius:7;-fx-padding:8 12;"/>
                <Button text="Ask" onAction="#onAskAi"
                        style="-fx-background-color:#2563EB;-fx-text-fill:white;-fx-font-size:11px;-fx-font-weight:700;-fx-background-radius:7;-fx-padding:8 12;-fx-cursor:hand;"/>
              </HBox>
              <TextArea fx:id="txtAiResponse" wrapText="true" prefHeight="90" editable="false"
                        style="-fx-font-size:11px;-fx-background-color:rgba(255,255,255,0.08);-fx-text-fill:white;-fx-border-color:rgba(37,99,235,0.3);-fx-border-radius:7;-fx-background-radius:7;-fx-padding:8;"/>
            </VBox>

          </VBox>
        </ScrollPane>
      </VBox>

    </HBox>
  </VBox>

</HBox>
