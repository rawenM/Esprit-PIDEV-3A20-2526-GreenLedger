<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/20.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.PorteurProjetsController"
      prefHeight="780" prefWidth="1320"
      style="-fx-background-color:#F8FAFC;"
            stylesheets="@../themes/app-base.css">

  <!-- SIDEBAR -->
  <VBox prefWidth="240" minWidth="240" maxWidth="240" spacing="0"
        style="-fx-background-color:#ffffff; -fx-border-color:#e5e7eb; -fx-border-width:0 1 0 0;">
    <VBox style="-fx-padding:22 18 18 18;-fx-spacing:4;-fx-border-color:#e5e7eb;-fx-border-width:0 0 1 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="GL" style="-fx-background-color:#059669;-fx-text-fill:white;-fx-font-size:13px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:36;-fx-min-height:36;-fx-max-width:36;-fx-max-height:36;-fx-alignment:CENTER;"/>
        <VBox spacing="1">
          <Label text="GreenLedger" style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:white;"/>
          <Label text="Porteur de Projet" style="-fx-font-size:9px;-fx-text-fill:#059669;-fx-font-weight:600;"/>
        </VBox>
      </HBox>
    </VBox>
    <VBox style="-fx-padding:16 14 6 14;">
      <Label text="NAVIGATION" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Tableau de bord" onAction="#onDashboard"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Mes projets" onAction="#onProjets"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:#f0fdf4;-fx-text-fill:#059669;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0 0 0 3;-fx-border-color:#059669;-fx-background-insets:0;-fx-effect:none;"/>
      <Button text="  Nouveau projet" onAction="#onNewProjet"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Mes évaluations" onAction="#onEvaluations"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Financement" onAction="#onFinancing"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
    </VBox>
    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="COMMUNICATION" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Messages" onAction="#onMessages"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Assistant IA" onAction="#onAssistant"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
    </VBox>
    <Region VBox.vgrow="ALWAYS"/>
    <VBox style="-fx-background-color:#f9fafb;-fx-padding:14;-fx-spacing:10;-fx-border-color:#e5e7eb;-fx-border-width:1 0 0 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="P" style="-fx-background-color:#dcfce7;-fx-text-fill:#059669;-fx-font-size:12px;-fx-font-weight:800;-fx-background-radius:20;-fx-min-width:38;-fx-min-height:38;-fx-max-width:38;-fx-max-height:38;-fx-alignment:CENTER;"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="lblProfileName" style="-fx-font-size:12px;-fx-font-weight:700;-fx-text-fill:white;"/>
          <Label fx:id="lblProfileType" style="-fx-font-size:9px;-fx-text-fill:#059669;"/>
        </VBox>
      </HBox>
      <HBox spacing="6">
        <Button text="Profil" onAction="#onEditProfile" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color:#f3f4f6;-fx-text-fill:#374151;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
        <Button text="Quitter" onAction="#onLogout"
                style="-fx-background-color:rgba(244,63,94,0.15);-fx-text-fill:#f43f5e;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-color:rgba(244,63,94,0.3);-fx-border-width:1;-fx-background-insets:0;"/>
      </HBox>
    </VBox>
  </VBox>

  <!-- MAIN CONTENT -->
  <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color:#F8FAFC;">

    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color:white;-fx-padding:14 28;-fx-border-color:#E2E8F0;-fx-border-width:0 0 1 0;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.04),8,0,0,2);">
      <Label text="Mes Projets"
             style="-fx-font-size:17px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <TextField fx:id="txtSearch" promptText="Rechercher..." prefWidth="220"
                 style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-padding:9 14;-fx-font-size:12px;"/>
      <ComboBox fx:id="cmbStatut" promptText="Tous" prefWidth="130"
                style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-font-size:12px;-fx-cursor:hand;"/>
      <Button text="Filtrer" onAction="#onFilter"
              style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-padding:9 18;-fx-cursor:hand;-fx-background-insets:0;"/>
      <Button text="+ Nouveau projet" onAction="#onNewProjet"
              style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:#111827;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:9 18;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;-fx-effect:dropshadow(gaussian,rgba(5,150,105,0.18),12,0,0,4);"/>
    </HBox>

    <!-- Content -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color:#F8FAFC;">
      <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

      <Label fx:id="lblCount" text=""
             style="-fx-font-size:11px;-fx-font-weight:600;-fx-text-fill:#64748B;-fx-padding:0 0 12 0;"/>

      <TableView fx:id="tableProjects" VBox.vgrow="ALWAYS"
                 style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:16;-fx-background-radius:16;-fx-table-cell-border-color:transparent;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.06),8,0,0,2);">
        <columns>
          <TableColumn fx:id="colId"       text="#"           prefWidth="50"  style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
          <TableColumn fx:id="colTitre"    text="TITRE"       prefWidth="240" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;"/>
          <TableColumn fx:id="colStatut"   text="STATUT"      prefWidth="130" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
          <TableColumn fx:id="colScore"    text="SCORE ESG"   prefWidth="110" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
          <TableColumn fx:id="colDecision" text="DÉCISION ML" prefWidth="130" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
          <TableColumn fx:id="colDate"     text="DATE"        prefWidth="120" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
          <TableColumn fx:id="colActions"  text="ACTIONS"     prefWidth="260" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;"/>
        </columns>
        <placeholder>
          <VBox alignment="CENTER" spacing="14" style="-fx-padding:50;">
            <Label text="Aucun projet trouvé"
                   style="-fx-font-size:14px;-fx-font-weight:600;-fx-text-fill:#94A3B8;"/>
            <Button text="+ Créer votre premier projet" onAction="#onNewProjet"
                    style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:#111827;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:10 20;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
          </VBox>
        </placeholder>
      </TableView>
    </VBox>

  </VBox>

</HBox>
