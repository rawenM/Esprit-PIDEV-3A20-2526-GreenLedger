<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/20.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.EvaluationDashboardController"
      prefHeight="780" prefWidth="1320"
      style="-fx-background-color:#F8FAFC;"
            stylesheets="@../themes/app-base.css">

  <!-- ═══ SIDEBAR ═══ -->
  <VBox prefWidth="240" minWidth="240" maxWidth="240" spacing="0"
        style="-fx-background-color:#ffffff; -fx-border-color:#e5e7eb; -fx-border-width:0 1 0 0;">
    <VBox style="-fx-padding:22 18 18 18;-fx-spacing:4;-fx-border-color:#e5e7eb;-fx-border-width:0 0 1 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="GL" style="-fx-background-color:#059669;-fx-text-fill:white;-fx-font-size:13px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:36;-fx-min-height:36;-fx-max-width:36;-fx-max-height:36;-fx-alignment:CENTER;"/>
        <VBox spacing="1">
          <Label text="GreenLedger" style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:white;"/>
          <Label text="Expert Carbone" style="-fx-font-size:9px;-fx-text-fill:#059669;-fx-font-weight:600;"/>
        </VBox>
      </HBox>
    </VBox>

    <VBox style="-fx-padding:16 14 6 14;">
      <Label text="ÉVALUATIONS" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Mes évaluations" onAction="#onQueue"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Dashboard évaluations" onAction="#onDashboard"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:#f0fdf4;-fx-text-fill:#059669;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0 0 0 3;-fx-border-color:#059669;-fx-background-insets:0;-fx-effect:none;"/>
    </VBox>

    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="PROFIL" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Modifier profil" onAction="#onEditProfile"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <VBox style="-fx-background-color:#f9fafb;-fx-padding:14;-fx-spacing:10;-fx-border-color:#e5e7eb;-fx-border-width:1 0 0 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="E" style="-fx-background-color:#dcfce7;-fx-text-fill:#059669;-fx-font-size:12px;-fx-font-weight:800;-fx-background-radius:20;-fx-min-width:38;-fx-min-height:38;-fx-max-width:38;-fx-max-height:38;-fx-alignment:CENTER;"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="lblProfileName" style="-fx-font-size:12px;-fx-font-weight:700;-fx-text-fill:white;"/>
          <Label fx:id="lblProfileType" style="-fx-font-size:9px;-fx-text-fill:#059669;"/>
        </VBox>
      </HBox>
      <HBox spacing="6">
        <Button text="Profil" onAction="#onEditProfile" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color:#f3f4f6;-fx-text-fill:#374151;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
        <Button text="Quitter" onAction="#onLogout"
                style="-fx-background-color:rgba(244,63,94,0.15);-fx-text-fill:#f43f5e;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-color:rgba(244,63,94,0.3);-fx-border-width:1;-fx-background-insets:0;"/>
      </HBox>
    </VBox>
  </VBox>

  <!-- ═══ MAIN CONTENT ═══ -->
  <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color:#F8FAFC;">

    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color:white;-fx-padding:14 28;-fx-border-color:#E2E8F0;-fx-border-width:0 0 1 0;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.04),8,0,0,2);">
      <Button text="Retour" onAction="#onBack"
              style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-padding:9 16;-fx-cursor:hand;-fx-background-insets:0;"/>
      <Label text="Dashboard Évaluations"
             style="-fx-font-size:17px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <TextField fx:id="txtSearch" promptText="Rechercher un projet..."
                 prefWidth="220"
                 style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-padding:9 14;-fx-font-size:12px;"/>
      <ComboBox fx:id="cmbDecision" promptText="Toutes décisions" prefWidth="160"
                style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-font-size:12px;-fx-cursor:hand;"/>
      <CheckBox fx:id="chkReeval" text="Réévaluées uniquement"
                style="-fx-font-size:12px;-fx-text-fill:#334155;"/>
      <Button text="Filtrer" onAction="#onFilter"
              style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:#111827;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:9 20;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;-fx-effect:dropshadow(gaussian,rgba(5,150,105,0.18),12,0,0,4);"/>
      <Label fx:id="lblTotal" text=""
             style="-fx-font-size:11px;-fx-text-fill:#64748B;-fx-padding:0 4;"/>
    </HBox>

    <!-- Scrollable body -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background:#F8FAFC;-fx-background-color:#F8FAFC;-fx-border-width:0;">
      <VBox spacing="24">
        <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>

        <!-- HERO BANNER -->
        <VBox spacing="16"
              style="-fx-background-color:linear-gradient(to bottom right,#059669,#10b981,#14b8a6);-fx-background-radius:18;-fx-padding:24 28;-fx-effect:dropshadow(gaussian,rgba(5,150,105,0.18),40,0,0,18);">
          <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
              <HBox>
                <Label text="EXPERT CARBONE"
                       style="-fx-background-color:rgba(255,255,255,0.15);-fx-border-color:rgba(255,255,255,0.30);-fx-border-width:1;-fx-background-radius:999;-fx-border-radius:999;-fx-padding:5 12;-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:700;"/>
              </HBox>
              <Label text="Dashboard Évaluations"
                     style="-fx-font-size:24px;-fx-font-weight:800;-fx-text-fill:white;"/>
              <Label text="Consultez, filtrez et gérez toutes vos évaluations carbone en un seul endroit."
                     style="-fx-font-size:12px;-fx-text-fill:rgba(255,255,255,0.80);" wrapText="true"/>
            </VBox>
            <VBox alignment="CENTER" spacing="4"
                  style="-fx-background-color:rgba(255,255,255,0.12);-fx-border-color:rgba(255,255,255,0.18);-fx-border-width:1;-fx-background-radius:14;-fx-border-radius:14;-fx-padding:16 22;">
              <Label text="TOTAL ÉVALS" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:rgba(255,255,255,0.84);"/>
              <Label fx:id="lblCount" text="—" style="-fx-font-size:26px;-fx-font-weight:800;-fx-text-fill:white;"/>
            </VBox>
          </HBox>
        </VBox>

        <!-- TABLE CARD -->
        <VBox spacing="0"
              style="-fx-background-color:white;-fx-background-radius:16;-fx-border-radius:16;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.06),8,0,0,2);">

          <!-- Card header -->
          <HBox alignment="CENTER_LEFT" spacing="12"
                style="-fx-padding:18 24;-fx-border-color:#E2E8F0;-fx-border-width:0 0 1 0;">
            <Label text="Mes évaluations"
                   style="-fx-font-size:15px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            <Region HBox.hgrow="ALWAYS"/>
          </HBox>

          <!-- Table -->
          <TableView fx:id="tableEvals" prefHeight="460" VBox.vgrow="ALWAYS"
                     style="-fx-background-color:transparent;-fx-border-width:0;-fx-table-cell-border-color:transparent;">
            <columns>
              <TableColumn fx:id="colProjet"     text="PROJET"        prefWidth="230" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;"/>
              <TableColumn fx:id="colScoreFinal" text="SCORE FINAL"   prefWidth="120" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colScoreMl"    text="SCORE ML"      prefWidth="110" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colDecision"   text="DÉCISION"      prefWidth="120" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colStatut"     text="STATUT PROJET" prefWidth="140" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colActions"    text="ACTIONS"       prefWidth="260" style="-fx-font-size:11px;-fx-font-weight:800;-fx-text-fill:#64748B;"/>
            </columns>
            <placeholder>
              <VBox alignment="CENTER" spacing="12" style="-fx-padding:50;">
                <Label text="Aucune évaluation trouvée"
                       style="-fx-font-size:14px;-fx-font-weight:600;-fx-text-fill:#94A3B8;"/>
                <Label text="Utilisez les filtres ci-dessus pour affiner votre recherche"
                       style="-fx-font-size:12px;-fx-text-fill:#CBD5E1;"/>
              </VBox>
            </placeholder>
          </TableView>

          <!-- Pagination -->
          <HBox alignment="CENTER" spacing="12"
                style="-fx-padding:16 24;-fx-border-color:#E2E8F0;-fx-border-width:1 0 0 0;">
            <Button fx:id="btnPrev" text="Précédent" onAction="#onPrevPage"
                    style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-padding:9 18;-fx-cursor:hand;-fx-background-insets:0;"/>
            <Label fx:id="lblPage" text="Page 1 / 1"
                   style="-fx-font-size:12px;-fx-text-fill:#64748B;-fx-padding:0 16;"/>
            <Button fx:id="btnNext" text="Suivant" onAction="#onNextPage"
                    style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:10;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-padding:9 18;-fx-cursor:hand;-fx-background-insets:0;"/>
          </HBox>
        </VBox>

      </VBox>
    </ScrollPane>
  </VBox>

</HBox>
