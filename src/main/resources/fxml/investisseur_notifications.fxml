<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.InvestisseurNotificationsController"
            prefHeight="700" prefWidth="860"
            style="-fx-background-color:#F8FAFC;">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color:#10b981;-fx-padding:14 24;">
      <Button text="Retour" onAction="#onBack"
              style="-fx-background-color:rgba(255,255,255,0.2);-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 14;-fx-cursor:hand;"/>
      <Label text="Notifications"
             style="-fx-font-size:16px;-fx-font-weight:800;-fx-text-fill:white;"/>
      <Label fx:id="lblUnreadCount" text=""
             style="-fx-background-color:rgba(244,63,94,0.8);-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:2 7;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Button text="Tout marquer lu" onAction="#onMarkAllRead"
              style="-fx-background-color:rgba(255,255,255,0.2);-fx-text-fill:white;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 14;-fx-cursor:hand;"/>
    </HBox>
  </top>
  <center>
    <VBox style="-fx-background-color:#F8FAFC;">
      <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                  style="-fx-background:#F8FAFC;-fx-background-color:#F8FAFC;">
        <VBox fx:id="boxNotifications" spacing="8">
          <Label fx:id="lblEmpty" text="Aucune notification"
                 style="-fx-font-size:14px;-fx-text-fill:#94A3B8;-fx-padding:20 0;"/>
        </VBox>
      </ScrollPane>
    </VBox>
  </center>
</BorderPane>
