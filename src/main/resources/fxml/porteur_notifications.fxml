<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.PorteurNotificationsController"
            prefHeight="700" prefWidth="900"
            style="-fx-background-color:#F7F9F8;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:white;-fx-border-color:#E5E7EB;-fx-border-width:0 0 1 0;-fx-padding:10 20;">
            <Button text="← Retour" onAction="#onBack"
                    style="-fx-background-color:#F3F4F6;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:6;-fx-padding:7 14;-fx-cursor:hand;-fx-border-color:#E5E7EB;-fx-border-width:1;"/>
            <Label text="Notifications" style="-fx-font-size:16px;-fx-font-weight:800;-fx-text-fill:#1A2E26;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Tout marquer lu" onAction="#onMarkAllRead"
                    style="-fx-background-color:#F3F4F6;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:6;-fx-padding:7 14;-fx-cursor:hand;-fx-border-color:#E5E7EB;-fx-border-width:1;"/>
        </HBox>
    </top>
    <center>
        <VBox style="-fx-background-color:#F7F9F8;">
            <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background:#F7F9F8;-fx-background-color:#F7F9F8;">
                <VBox fx:id="boxNotifications" spacing="8">
                    <Label fx:id="lblEmpty" text="Aucune notification"
                           style="-fx-font-size:14px;-fx-text-fill:#9CA3AF;-fx-padding:20 0;"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
