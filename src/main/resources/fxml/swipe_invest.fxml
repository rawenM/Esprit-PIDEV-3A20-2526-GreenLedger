<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/20.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.SwipeInvestController"
      prefHeight="780" prefWidth="1320"
      style="-fx-background-color:#F8FAFC;"
            stylesheets="@../themes/app-base.css">

  <!-- SIDEBAR -->
  <VBox prefWidth="240" minWidth="240" maxWidth="240" spacing="0"
        style="-fx-background-color:#ffffff; -fx-border-color:#e5e7eb; -fx-border-width:0 1 0 0;">
    <VBox style="-fx-padding:22 18 18 18;-fx-spacing:4;-fx-border-color:#e5e7eb;-fx-border-width:0 0 1 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="GL" style="-fx-background-color:#059669;-fx-text-fill:white;-fx-font-size:13px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:36;-fx-min-height:36;-fx-max-width:36;-fx-max-height:36;-fx-alignment:CENTER;"/>
        <VBox spacing="1">
          <Label text="GreenLedger" style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:white;"/>
          <Label text="Investisseur" style="-fx-font-size:9px;-fx-text-fill:#059669;-fx-font-weight:600;"/>
        </VBox>
      </HBox>
    </VBox>
    <VBox style="-fx-padding:16 14 6 14;">
      <Label text="PRINCIPAL" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Tableau de bord" onAction="#onDashboard"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Découvrir projets" onAction="#onSwipe"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:#f0fdf4;-fx-text-fill:#059669;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0 0 0 3;-fx-border-color:#059669;-fx-background-insets:0;-fx-effect:none;"/>
      <Button text="  Mon portefeuille" onAction="#onPortfolio"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
      <Button text="  Marché carbone" onAction="#onMarketplace"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:#374151;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
    </VBox>
    <Region VBox.vgrow="ALWAYS"/>
    <VBox style="-fx-background-color:#f9fafb;-fx-padding:14;-fx-spacing:10;-fx-border-color:#e5e7eb;-fx-border-width:1 0 0 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="I" style="-fx-background-color:#dcfce7;-fx-text-fill:#059669;-fx-font-size:12px;-fx-font-weight:800;-fx-background-radius:20;-fx-min-width:38;-fx-min-height:38;-fx-max-width:38;-fx-max-height:38;-fx-alignment:CENTER;"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="lblProfileName" style="-fx-font-size:12px;-fx-font-weight:700;-fx-text-fill:white;"/>
          <Label fx:id="lblProfileType" style="-fx-font-size:9px;-fx-text-fill:#059669;"/>
        </VBox>
      </HBox>
      <HBox spacing="6">
        <Button text="Profil" onAction="#onEditProfile" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color:#f3f4f6;-fx-text-fill:#374151;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
        <Button text="Quitter" onAction="#onLogout"
                style="-fx-background-color:rgba(244,63,94,0.15);-fx-text-fill:#f43f5e;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-color:rgba(244,63,94,0.3);-fx-border-width:1;-fx-background-insets:0;"/>
      </HBox>
    </VBox>
  </VBox>

  <!-- MAIN CONTENT -->
  <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color:#F8FAFC;">

    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color:white;-fx-padding:14 28;-fx-border-color:#E2E8F0;-fx-border-width:0 0 1 0;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.04),8,0,0,2);">
      <Label text="Découvrir des Projets"
             style="-fx-font-size:17px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
      <Label text="Swipez pour investir"
             style="-fx-font-size:12px;-fx-text-fill:#64748B;-fx-padding:0 0 0 8;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="lblCardCount" text=""
             style="-fx-font-size:12px;-fx-font-weight:600;-fx-text-fill:#64748B;"/>
    </HBox>

    <!-- Body: card stack + decision tree -->
    <HBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="24" style="-fx-padding:32;-fx-background-color:#F8FAFC;">

      <!-- LEFT: Card stack area -->
      <VBox HBox.hgrow="ALWAYS" spacing="20" alignment="TOP_CENTER">

        <!-- Empty state -->
        <VBox fx:id="boxEmpty" alignment="CENTER" spacing="16"
              style="-fx-background-color:white;-fx-background-radius:18;-fx-border-radius:18;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-padding:60;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.06),8,0,0,2);"
              visible="false" managed="false">
          <Label text="🎉" style="-fx-font-size:48px;"/>
          <Label text="Vous avez vu tous les projets !"
                 style="-fx-font-size:18px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
          <Label text="Revenez plus tard pour découvrir de nouveaux projets."
                 style="-fx-font-size:13px;-fx-text-fill:#64748B;"/>
          <Button text="Retour au tableau de bord" onAction="#onDashboard"
                  style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:white;-fx-font-size:13px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:12 24;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
        </VBox>

        <!-- Card container (programmatically filled) -->
        <StackPane fx:id="cardStack" prefWidth="480" prefHeight="560" alignment="CENTER"/>

        <!-- Action buttons -->
        <HBox fx:id="boxActions" spacing="20" alignment="CENTER">
          <Button fx:id="btnSkip" text="⏭ Passer" onAction="#onSkip"
                  prefWidth="130" prefHeight="48"
                  style="-fx-background-color:#F8FAFC;-fx-text-fill:#64748B;-fx-font-size:13px;-fx-font-weight:700;-fx-background-radius:999;-fx-border-color:#CBD5E1;-fx-border-width:2;-fx-cursor:hand;-fx-background-insets:0;"/>
          <Button fx:id="btnLeft" text="✕ Ignorer" onAction="#onSwipeLeft"
                  prefWidth="130" prefHeight="56"
                  style="-fx-background-color:#FFF1F2;-fx-text-fill:#F43F5E;-fx-font-size:14px;-fx-font-weight:800;-fx-background-radius:999;-fx-border-color:#FECDD3;-fx-border-width:2;-fx-cursor:hand;-fx-background-insets:0;-fx-effect:dropshadow(gaussian,rgba(244,63,94,0.15),8,0,0,2);"/>
          <Button fx:id="btnRight" text="♥ Investir" onAction="#onSwipeRight"
                  prefWidth="130" prefHeight="56"
                  style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:#064e3b;-fx-font-size:14px;-fx-font-weight:800;-fx-background-radius:999;-fx-border-width:0;-fx-cursor:hand;-fx-background-insets:0;-fx-effect:dropshadow(gaussian,rgba(5,150,105,0.25),12,0,0,4);"/>
        </HBox>
      </VBox>

      <!-- RIGHT: Decision tree panel -->
      <VBox spacing="16" prefWidth="320" minWidth="300">

        <!-- Decision tree card -->
        <VBox spacing="14"
              style="-fx-background-color:white;-fx-background-radius:16;-fx-border-radius:16;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.06),8,0,0,2);">
          <Label text="Analyse du projet"
                 style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>

          <!-- Risk badge -->
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblRiskIcon" text="—" style="-fx-font-size:20px;"/>
            <Label fx:id="lblRiskLevel" text="—"
                   style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:#64748B;"/>
          </HBox>

          <!-- Verdict -->
          <Label fx:id="lblVerdict" text="Sélectionnez un projet pour voir l'analyse."
                 wrapText="true"
                 style="-fx-font-size:12px;-fx-text-fill:#64748B;-fx-background-color:#F8FAFC;-fx-background-radius:8;-fx-padding:10 12;"/>

          <!-- ESG bar -->
          <VBox spacing="6">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Score ESG" style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#334155;"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblEsgValue" text="—"
                     style="-fx-font-size:12px;-fx-font-weight:800;-fx-text-fill:#059669;"/>
            </HBox>
            <ProgressBar fx:id="progressEsg" progress="0" maxWidth="Infinity"
                         style="-fx-accent:#059669;-fx-pref-height:8;-fx-background-color:#F1F5F9;-fx-background-radius:999;"/>
          </VBox>

          <!-- Fraud bar -->
          <VBox spacing="6">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Risque fraude" style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#334155;"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblFraudValue" text="—"
                     style="-fx-font-size:12px;-fx-font-weight:800;-fx-text-fill:#F43F5E;"/>
            </HBox>
            <ProgressBar fx:id="progressFraud" progress="0" maxWidth="Infinity"
                         style="-fx-accent:#F43F5E;-fx-pref-height:8;-fx-background-color:#F1F5F9;-fx-background-radius:999;"/>
          </VBox>

          <!-- Rule path -->
          <HBox alignment="CENTER_LEFT" spacing="8"
                style="-fx-background-color:#F0FDF4;-fx-background-radius:8;-fx-padding:10 12;">
            <Label text="Règle:" style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#334155;"/>
            <Label fx:id="lblRulePath" text="—"
                   style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#059669;"/>
          </HBox>
        </VBox>

        <!-- Project details card -->
        <VBox spacing="10"
              style="-fx-background-color:white;-fx-background-radius:16;-fx-border-radius:16;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.06),8,0,0,2);">
          <Label text="Détails du projet"
                 style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
          <VBox spacing="8">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Secteur" style="-fx-font-size:11px;-fx-text-fill:#64748B;-fx-min-width:90;"/>
              <Label fx:id="lblDetailSecteur" text="—"
                     style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#0F172A;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Montant" style="-fx-font-size:11px;-fx-text-fill:#64748B;-fx-min-width:90;"/>
              <Label fx:id="lblDetailMontant" text="—"
                     style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#059669;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Localisation" style="-fx-font-size:11px;-fx-text-fill:#64748B;-fx-min-width:90;"/>
              <Label fx:id="lblDetailLoc" text="—"
                     style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#0F172A;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="CO2 évité" style="-fx-font-size:11px;-fx-text-fill:#64748B;-fx-min-width:90;"/>
              <Label fx:id="lblDetailCo2" text="—"
                     style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#14b8a6;"/>
            </HBox>
          </VBox>
        </VBox>

        <!-- Amount input for investment -->
        <VBox spacing="10"
              style="-fx-background-color:white;-fx-background-radius:16;-fx-border-radius:16;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-padding:20 22;-fx-effect:dropshadow(gaussian,rgba(15,23,42,0.06),8,0,0,2);">
          <Label text="Montant à investir (USD)"
                 style="-fx-font-size:13px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
          <TextField fx:id="txtAmount" promptText="Ex: 5000"
                     style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-padding:12 14;-fx-font-size:14px;-fx-font-weight:700;"/>
          <Label fx:id="lblAmountHint" text="Entrez un montant puis cliquez Investir"
                 style="-fx-font-size:10px;-fx-text-fill:#94A3B8;" wrapText="true"/>
        </VBox>

      </VBox>
    </HBox>
  </VBox>

  <!-- STRIPE PAYMENT MODAL OVERLAY -->
  <StackPane fx:id="stripeOverlay" visible="false" managed="false"
             style="-fx-background-color:rgba(0,0,0,0.50);"
             HBox.hgrow="ALWAYS">
    <VBox alignment="CENTER" spacing="0" maxWidth="480"
          style="-fx-background-color:white;-fx-background-radius:18;-fx-border-radius:18;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.30),60,0,0,20);">

      <!-- Modal header -->
      <VBox spacing="6"
            style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-background-radius:18 18 0 0;-fx-padding:24 28;">
        <Label text="Confirmer l'investissement"
               style="-fx-font-size:18px;-fx-font-weight:800;-fx-text-fill:white;"/>
        <Label fx:id="lblModalProject" text=""
               style="-fx-font-size:12px;-fx-text-fill:rgba(255,255,255,0.80);"/>
      </VBox>

      <!-- Modal body -->
      <VBox spacing="20" style="-fx-padding:28;">

        <!-- Amount display -->
        <HBox alignment="CENTER" spacing="8"
              style="-fx-background-color:#F0FDF4;-fx-background-radius:12;-fx-padding:16 20;">
          <Label text="Montant:" style="-fx-font-size:14px;-fx-text-fill:#334155;"/>
          <Label fx:id="lblModalAmount" text="0 USD"
                 style="-fx-font-size:22px;-fx-font-weight:800;-fx-text-fill:#059669;"/>
        </HBox>

        <!-- Card info section -->
        <VBox spacing="10">
          <Label text="INFORMATIONS DE PAIEMENT"
                 style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:#64748B;"/>

          <VBox spacing="8">
            <Label text="Numéro de carte (test: 4242 4242 4242 4242)"
                   style="-fx-font-size:11px;-fx-font-weight:600;-fx-text-fill:#334155;"/>
            <TextField fx:id="txtCardNumber" promptText="4242 4242 4242 4242"
                       style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-padding:12 14;-fx-font-size:14px;"/>
          </VBox>

          <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
              <Label text="Expiration (MM/AA)"
                     style="-fx-font-size:11px;-fx-font-weight:600;-fx-text-fill:#334155;"/>
              <TextField fx:id="txtExpiry" promptText="12/28"
                         style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-padding:12 14;-fx-font-size:14px;"/>
            </VBox>
            <VBox spacing="6" prefWidth="120">
              <Label text="CVC"
                     style="-fx-font-size:11px;-fx-font-weight:600;-fx-text-fill:#334155;"/>
              <TextField fx:id="txtCvc" promptText="123"
                         style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-radius:10;-fx-border-radius:10;-fx-padding:12 14;-fx-font-size:14px;"/>
            </VBox>
          </HBox>
        </VBox>

        <!-- Status label -->
        <Label fx:id="lblPaymentStatus" text=""
               wrapText="true"
               style="-fx-font-size:12px;-fx-font-weight:600;-fx-text-fill:#059669;"/>

        <!-- Buttons -->
        <HBox spacing="12" alignment="CENTER_RIGHT">
          <Button text="Annuler" onAction="#onCancelPayment"
                  style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:13px;-fx-font-weight:700;-fx-background-radius:10;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-padding:12 22;-fx-cursor:hand;-fx-background-insets:0;"/>
          <Button fx:id="btnConfirmPayment" text="Confirmer le paiement" onAction="#onConfirmPayment"
                  style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:white;-fx-font-size:13px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:12 22;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;-fx-effect:dropshadow(gaussian,rgba(5,150,105,0.18),12,0,0,4);"/>
        </HBox>

        <!-- Security note -->
        <Label text="🔒 Paiement sécurisé via Stripe. Vos données ne sont jamais stockées sur nos serveurs."
               wrapText="true"
               style="-fx-font-size:10px;-fx-text-fill:#94A3B8;-fx-text-alignment:CENTER;"/>
      </VBox>
    </VBox>
  </StackPane>

</HBox>
