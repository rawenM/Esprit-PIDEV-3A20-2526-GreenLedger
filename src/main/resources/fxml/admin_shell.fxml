<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.AdminShellController"
            prefHeight="760" prefWidth="1280"
            stylesheets="@../themes/admin-backoffice.css">

    <!-- ══════════════════════════════════════════
         SIDEBAR  (300 px, dark gradient)
    ══════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="260" minWidth="260" maxWidth="260"
              styleClass="gl-sidebar" spacing="0">

            <!-- Brand -->
            <HBox styleClass="gl-brand" alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="22" right="18" bottom="18" left="18"/></padding>
                <Label text="GL" styleClass="gl-brand-mark"/>
                <VBox spacing="1">
                    <Label text="GreenLedger" styleClass="gl-brand-name"/>
                    <Label text="BACK OFFICE"  styleClass="gl-brand-sub"/>
                </VBox>
            </HBox>

            <!-- ── OVERVIEW ── -->
            <Label text="OVERVIEW" styleClass="gl-nav-section"/>
            <Button fx:id="btnDashboard" text="  Tableau de bord"
                    onAction="#onDashboard" styleClass="gl-nav-btn"/>
            <Button fx:id="btnUsers" text="  Utilisateurs"
                    onAction="#onUsers" styleClass="gl-nav-btn gl-nav-active"/>

            <!-- ── MANAGEMENT ── -->
            <Label text="MANAGEMENT" styleClass="gl-nav-section"/>
            <Button fx:id="btnProjets"     text="  Projets"
                    onAction="#onProjets"     styleClass="gl-nav-btn"/>
            <Button fx:id="btnEvaluations" text="  Évaluations"
                    onAction="#onEvaluations" styleClass="gl-nav-btn"/>

            <!-- ── FINANCE ── -->
            <Label text="FINANCE" styleClass="gl-nav-section"/>
            <Button fx:id="btnCredits"  text="  Crédits verts"
                    onAction="#onCredits"  styleClass="gl-nav-btn"/>
            <Button fx:id="btnWallet"   text="  Wallets"
                    onAction="#onWallet"   styleClass="gl-nav-btn"/>

            <!-- ── SUPERVISION ── -->
            <Label text="SUPERVISION" styleClass="gl-nav-section"/>
            <Button fx:id="btnAuditNav"  text="  Journal d'audit"
                    onAction="#onAudit"      styleClass="gl-nav-btn"/>
            <Button fx:id="btnCarteConn" text="  Carte connexions"
                    onAction="#onCarteConn"  styleClass="gl-nav-btn"/>
            <Button fx:id="btnFraud"     text="  Fraude &amp; Risques"
                    onAction="#onFraud"      styleClass="gl-nav-btn"/>
            <Button fx:id="btnCriteres"  text="  Analytics"
                    onAction="#onCriteres"   styleClass="gl-nav-btn"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bottom actions -->
            <VBox styleClass="gl-side-actions" spacing="2">
                <padding><Insets top="12" right="12" bottom="16" left="12"/></padding>
                <Separator styleClass="gl-sep"/>
                <Button text="  Profil"       onAction="#onEditProfile" styleClass="gl-side-link"/>
                <Button text="  Déconnexion"  onAction="#onLogout"      styleClass="gl-side-link gl-logout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════
         TOP BAR
    ══════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="0" styleClass="gl-topbar">
            <padding><Insets top="0" right="24" bottom="0" left="28"/></padding>

            <!-- Breadcrumb -->
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="Back Office / Utilisateurs" styleClass="gl-breadcrumb"/>
                <Label fx:id="lblPageTitle" text="Utilisateurs" styleClass="gl-topbar-title"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Right: bell + avatar -->
            <HBox alignment="CENTER" spacing="14">
                <Button text="🔔" onAction="#onNotifications" styleClass="gl-icon-btn"/>
                <HBox alignment="CENTER" spacing="10">
                    <Label styleClass="gl-avatar" text="SA"/>
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label fx:id="lblProfileName" text="Super Admin" styleClass="gl-user-name"/>
                        <Label fx:id="lblProfileType" text="Administrateur" styleClass="gl-user-role"/>
                    </VBox>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea">
            <ScrollPane fitToWidth="true" styleClass="gl-scroll">
                <VBox spacing="24" styleClass="gl-content">
                    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

                    <!-- ── 6 KPI CARDS ── -->
                    <HBox spacing="14">
                        <!-- Total -->
                        <VBox styleClass="gl-kpi-card" HBox.hgrow="ALWAYS">
                            <Label text="Utilisateurs" styleClass="gl-kpi-label"/>
                            <Label fx:id="statTotal"   text="—"  styleClass="gl-kpi-value"/>
                        </VBox>
                        <!-- Actifs -->
                        <VBox styleClass="gl-kpi-card gl-kpi-green" HBox.hgrow="ALWAYS">
                            <Label text="Actifs"       styleClass="gl-kpi-label"/>
                            <Label fx:id="statActifs"  text="—"  styleClass="gl-kpi-value gl-kpi-green-val"/>
                        </VBox>
                        <!-- En attente -->
                        <VBox styleClass="gl-kpi-card gl-kpi-amber" HBox.hgrow="ALWAYS">
                            <Label text="En attente"   styleClass="gl-kpi-label"/>
                            <Label fx:id="statAttente" text="—"  styleClass="gl-kpi-value gl-kpi-amber-val"/>
                        </VBox>
                        <!-- Bloqués -->
                        <VBox styleClass="gl-kpi-card gl-kpi-red" HBox.hgrow="ALWAYS">
                            <Label text="Bloqués"      styleClass="gl-kpi-label"/>
                            <Label fx:id="statBloques" text="—"  styleClass="gl-kpi-value gl-kpi-red-val"/>
                        </VBox>
                        <!-- Suspendus -->
                        <VBox styleClass="gl-kpi-card" HBox.hgrow="ALWAYS">
                            <Label text="Suspendus"    styleClass="gl-kpi-label"/>
                            <Label fx:id="statSuspendus" text="—" styleClass="gl-kpi-value"/>
                        </VBox>
                        <!-- Fraude -->
                        <VBox styleClass="gl-kpi-card gl-kpi-orange" HBox.hgrow="ALWAYS">
                            <Label text="Fraude"       styleClass="gl-kpi-label"/>
                            <Label fx:id="statFraud"   text="—"  styleClass="gl-kpi-value gl-kpi-orange-val"/>
                        </VBox>
                    </HBox>

                    <!-- ── SEARCH & FILTER BAR ── -->
                    <VBox styleClass="gl-surface" spacing="12">
                        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="txtSearch"
                                       promptText="🔍  Rechercher un utilisateur…"
                                       prefWidth="280" styleClass="gl-field"/>
                            <ComboBox fx:id="cmbType"   promptText="Rôle"   prefWidth="160" styleClass="gl-combo"/>
                            <ComboBox fx:id="cmbStatut" promptText="Statut" prefWidth="160" styleClass="gl-combo"/>
                            <Button text="Rechercher" onAction="#onSearch" styleClass="gl-btn-search"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Nouvel utilisateur" onAction="#onNewUser"   styleClass="gl-btn-primary"/>
                            <Button text="↓ Export CSV"         onAction="#onExportCsv" styleClass="gl-btn-ghost"/>
                        </HBox>
                        <Label text="Recherche en temps réel — résultats mis à jour automatiquement"
                               styleClass="gl-hint"/>
                    </VBox>

                    <!-- ── TABLE CARD ── -->
                    <VBox styleClass="gl-surface" spacing="0">

                        <!-- Table header row -->
                        <HBox styleClass="gl-table-header" alignment="CENTER_LEFT" spacing="0">
                            <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
                            <Label fx:id="lblCount" text="— utilisateur(s) trouvé(s)"
                                   styleClass="gl-table-count"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <TableView fx:id="tableUsers" prefHeight="420"
                                   styleClass="gl-table">
                            <columns>
                                <TableColumn fx:id="colId"      text="ID"          prefWidth="55"/>
                                <TableColumn fx:id="colNom"     text="Utilisateur" prefWidth="190"/>
                                <TableColumn fx:id="colEmail"   text="Email"       prefWidth="210"/>
                                <TableColumn fx:id="colType"    text="Rôle"        prefWidth="150"/>
                                <TableColumn fx:id="colStatut"  text="Statut"      prefWidth="110"/>
                                <TableColumn fx:id="colDate"    text="Inscription" prefWidth="110"/>
                                <TableColumn fx:id="colFraud"   text="Fraude"      prefWidth="80"/>
                                <TableColumn fx:id="colActions" text="Actions"     prefWidth="230"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- ── PENDING ACTIVATION SECTION ── -->
                    <VBox fx:id="pendingSection" styleClass="gl-pending-box" spacing="10">
                        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⚠" styleClass="gl-pending-icon"/>
                            <Label text="Comptes en attente d'activation"
                                   styleClass="gl-pending-title"/>
                        </HBox>
                        <VBox fx:id="pendingList" spacing="8"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
