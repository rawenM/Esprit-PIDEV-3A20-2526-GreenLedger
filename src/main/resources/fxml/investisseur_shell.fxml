<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/20.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.InvestisseurShellController"
      prefHeight="780" prefWidth="1320"
      style="-fx-background-color:#F8FAFC;"
            stylesheets="@../themes/app-base.css">

  <!-- ═══ SIDEBAR ═══ -->
  <VBox prefWidth="240" spacing="0"
        style="-fx-background-color:#0F172A;-fx-border-color:#1E293B;-fx-border-width:0 1 0 0;">
    <!-- Brand -->
    <VBox style="-fx-padding:22 18 18 18;-fx-spacing:4;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="GL"
               style="-fx-background-color:#10b981;-fx-text-fill:white;-fx-font-size:13px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:36;-fx-min-height:36;-fx-alignment:CENTER;"/>
        <VBox spacing="1">
          <Label text="GreenLedger" style="-fx-font-size:14px;-fx-font-weight:800;-fx-text-fill:white;"/>
          <Label text="Investisseur" style="-fx-font-size:9px;-fx-text-fill:rgba(16,185,129,0.7);-fx-font-weight:600;"/>
        </VBox>
      </HBox>
    </VBox>
    <Separator style="-fx-background-color:#1E293B;-fx-opacity:1;"/>

    <!-- Nav -->
    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="PRINCIPAL" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:rgba(255,255,255,0.25);"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button fx:id="btnDashboard" text="  Tableau de bord" onAction="#onDashboard"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:#1E3A2F;-fx-text-fill:#10b981;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;-fx-border-color:#10b981;-fx-border-width:0 0 0 3;"/>
      <Button fx:id="btnFinancing" text="  Découvrir projets" onAction="#onFinancing"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;"/>
      <Button fx:id="btnPortfolio" text="  Mon portefeuille" onAction="#onPortfolio"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;"/>
      <Button fx:id="btnWallet" text="  Wallet credits" onAction="#onWallet"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;"/>
      <Button fx:id="btnMarketplace" text="  Marche carbone" onAction="#onMarketplace"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;"/>
    </VBox>

    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="COMMUNICATION" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:rgba(255,255,255,0.25);"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button fx:id="btnMessages" text="  Messages" onAction="#onMessages"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;"/>
      <Button text="  Notifications" onAction="#onNotifications"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;"/>
      <Button fx:id="btnAssistant" text="  Assistant IA" onAction="#onAssistant"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.65);-fx-font-size:12px;-fx-background-radius:8;-fx-padding:11 14;-fx-cursor:hand;"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Profile footer -->
    <VBox style="-fx-background-color:#070F1A;-fx-padding:14;-fx-spacing:10;">
      <Separator style="-fx-background-color:#1E293B;-fx-opacity:1;"/>
      <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:6 0 0 0;">
        <Label text="I"
               style="-fx-background-color:#10b981;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:800;-fx-background-radius:20;-fx-min-width:38;-fx-min-height:38;-fx-alignment:CENTER;"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="lblProfileName" style="-fx-font-size:12px;-fx-font-weight:700;-fx-text-fill:white;"/>
          <Label fx:id="lblProfileType" style="-fx-font-size:9px;-fx-text-fill:rgba(16,185,129,0.6);"/>
        </VBox>
      </HBox>
      <HBox spacing="6">
        <Button text="Profil" onAction="#onEditProfile" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color:#1E293B;-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;"/>
        <Button text="Quitter" onAction="#onLogout"
                style="-fx-background-color:rgba(244,63,94,0.15);-fx-text-fill:#f43f5e;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-color:rgba(244,63,94,0.3);-fx-border-width:1;"/>
      </HBox>
    </VBox>
  </VBox>

  <!-- ═══ MAIN CONTENT ═══ -->
  <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color:#F8FAFC;">
    <!-- Top bar -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color:white;-fx-padding:12 28;-fx-border-color:#E2E8F0;-fx-border-width:0 0 1 0;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);">
      <Label fx:id="lblPageTitle" text="Tableau de bord"
             style="-fx-font-size:17px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="lblUnreadBadge" text=""
             style="-fx-background-color:#f43f5e;-fx-text-fill:white;-fx-font-size:9px;-fx-font-weight:700;-fx-background-radius:10;-fx-padding:2 7;"/>
      <Button text="Découvrir maintenant" onAction="#onFinancing"
              style="-fx-background-color:#10b981;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:9 18;-fx-cursor:hand;"/>
    </HBox>

    <!-- Scrollable body -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background:#F8FAFC;-fx-background-color:#F8FAFC;">
      <VBox spacing="22">
        <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>

        <!-- Hero banner -->
        <VBox spacing="8"
              style="-fx-background-color:#10b981;-fx-background-radius:16;-fx-padding:24 28;-fx-effect:dropshadow(gaussian,rgba(16,185,129,0.3),12,0,0,4);">
          <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label fx:id="lblHeroGreeting" text="Bonjour Investisseur"
                     style="-fx-font-size:22px;-fx-font-weight:800;-fx-text-fill:white;"/>
              <Label text="Voici votre cockpit GreenLedger — credits, projets et marche en un coup d'oeil."
                     style="-fx-font-size:12px;-fx-text-fill:rgba(255,255,255,0.75);" wrapText="true"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3"
                  style="-fx-background-color:rgba(255,255,255,0.15);-fx-border-color:rgba(255,255,255,0.3);-fx-border-width:1;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:12 20;">
              <Label text="HEALTH SCORE" style="-fx-font-size:8px;-fx-font-weight:700;-fx-text-fill:rgba(255,255,255,0.7);"/>
              <Label fx:id="lblHealthScore" text="—"
                     style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:white;"/>
              <Label text="/ 100" style="-fx-font-size:10px;-fx-text-fill:rgba(255,255,255,0.5);"/>
            </VBox>
          </HBox>
        </VBox>

        <!-- KPI Row 1 -->
        <HBox spacing="14">
          <!-- Credits disponibles -->
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#10b981;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="C" style="-fx-background-color:#D1FAE5;-fx-text-fill:#10b981;-fx-font-size:11px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:30;-fx-min-height:30;-fx-alignment:CENTER;"/>
              <Label text="CREDITS DISPONIBLES" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            </HBox>
            <Label fx:id="statCredits" text="—" style="-fx-font-size:32px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            <Label fx:id="statCreditsRetired" text="" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
          <!-- Wallets actifs -->
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#14b8a6;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="W" style="-fx-background-color:#CCFBF1;-fx-text-fill:#14b8a6;-fx-font-size:11px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:30;-fx-min-height:30;-fx-alignment:CENTER;"/>
              <Label text="WALLETS ACTIFS" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            </HBox>
            <Label fx:id="statWallets" text="—" style="-fx-font-size:32px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            <Label fx:id="statWalletsSub" text="" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
          <!-- Projets portfolio -->
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#818cf8;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="P" style="-fx-background-color:#E0E7FF;-fx-text-fill:#818cf8;-fx-font-size:11px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:30;-fx-min-height:30;-fx-alignment:CENTER;"/>
              <Label text="PROJETS PORTFOLIO" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            </HBox>
            <Label fx:id="statProjects" text="—" style="-fx-font-size:32px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            <Label fx:id="statProjectsSub" text="" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
          <!-- Pipeline -->
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#f59e0b;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="F" style="-fx-background-color:#FEF3C7;-fx-text-fill:#f59e0b;-fx-font-size:11px;-fx-font-weight:800;-fx-background-radius:8;-fx-min-width:30;-fx-min-height:30;-fx-alignment:CENTER;"/>
              <Label text="PIPELINE FINANCEMENT" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            </HBox>
            <Label fx:id="statPipeline" text="—" style="-fx-font-size:32px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            <Label fx:id="statPipelineSub" text="" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
        </HBox>

        <!-- KPI Row 2 -->
        <HBox spacing="14">
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#38bdf8;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <Label text="ANNONCES ACTIVES" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            <Label fx:id="statListings" text="—" style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            <Label text="Sur le marche carbone" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#f43f5e;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <Label text="MES ORDRES" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            <Label fx:id="statOrders" text="—" style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
            <Label text="Achats / ventes" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#10b981;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <Label text="HEALTH SCORE" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            <Label fx:id="statHealth" text="—" style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#10b981;"/>
            <Label text="/ 100" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
          <VBox HBox.hgrow="ALWAYS" spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-left-width:3;-fx-border-left-color:#f59e0b;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:18 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <Label text="READINESS" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
            <Label fx:id="statReadiness" text="—" style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#f59e0b;"/>
            <Label text="/ 100" style="-fx-font-size:10px;-fx-text-fill:#94A3B8;"/>
          </VBox>
        </HBox>

        <!-- Quick actions -->
        <VBox spacing="12"
              style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:14;-fx-background-radius:14;-fx-padding:20 24;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
          <Label text="Actions rapides" style="-fx-font-size:13px;-fx-font-weight:700;-fx-text-fill:#0F172A;"/>
          <HBox spacing="10">
            <Button text="Messages" onAction="#onMessages"
                    style="-fx-background-color:#10b981;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:9;-fx-padding:10 18;-fx-cursor:hand;"/>
            <Button text="Mes projets" onAction="#onPortfolio"
                    style="-fx-background-color:#14b8a6;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:9;-fx-padding:10 18;-fx-cursor:hand;"/>
            <Button text="Mon wallet" onAction="#onWallet"
                    style="-fx-background-color:#818cf8;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:9;-fx-padding:10 18;-fx-cursor:hand;"/>
            <Button text="Marche carbone" onAction="#onMarketplace"
                    style="-fx-background-color:#38bdf8;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:9;-fx-padding:10 18;-fx-cursor:hand;"/>
            <Button text="Investir" onAction="#onFinancing"
                    style="-fx-background-color:#f59e0b;-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:9;-fx-padding:10 18;-fx-cursor:hand;"/>
          </HBox>
        </VBox>

        <!-- Available projects table -->
        <VBox spacing="12"
              style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:14;-fx-background-radius:14;-fx-padding:20 24;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Projets disponibles a l'investissement"
                   style="-fx-font-size:13px;-fx-font-weight:700;-fx-text-fill:#0F172A;"/>
            <Label text="APPROVED"
                   style="-fx-background-color:#D1FAE5;-fx-text-fill:#10b981;-fx-font-size:9px;-fx-font-weight:700;-fx-background-radius:4;-fx-padding:2 7;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voir tous" onAction="#onFinancing"
                    style="-fx-background-color:transparent;-fx-text-fill:#10b981;-fx-font-size:11px;-fx-font-weight:600;-fx-cursor:hand;-fx-padding:4 10;-fx-border-color:rgba(16,185,129,0.3);-fx-border-width:1;-fx-border-radius:6;-fx-background-radius:6;"/>
          </HBox>
          <TableView fx:id="tableProjects" prefHeight="240"
                     style="-fx-background-color:transparent;-fx-border-color:#E2E8F0;-fx-border-radius:10;-fx-background-radius:10;">
            <columns>
              <TableColumn fx:id="colTitre"   text="PROJET"   prefWidth="220"/>
              <TableColumn fx:id="colSecteur" text="SECTEUR"  prefWidth="110" style="-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colEsg"     text="ESG"      prefWidth="70"  style="-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colMontant" text="DEMANDE"  prefWidth="110" style="-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colFraud"   text="RISQUE"   prefWidth="90"  style="-fx-alignment:CENTER;"/>
              <TableColumn fx:id="colAction"  text="ACTION"   prefWidth="120" style="-fx-alignment:CENTER;"/>
            </columns>
            <placeholder>
              <VBox alignment="CENTER" spacing="8" style="-fx-padding:30;">
                <Label text="Aucun projet disponible" style="-fx-font-size:13px;-fx-text-fill:#94A3B8;"/>
              </VBox>
            </placeholder>
          </TableView>
        </VBox>

      </VBox>
    </ScrollPane>
  </VBox>

</HBox>
