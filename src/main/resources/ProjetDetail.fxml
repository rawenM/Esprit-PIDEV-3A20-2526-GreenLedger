<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/20.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.ProjetDetailController"
      prefHeight="780" prefWidth="1320"
      style="-fx-background-color:#F8FAFC;"
      stylesheets="@../themes/app-base.css">

  <!-- ═══ SIDEBAR ═══ -->
  <VBox prefWidth="240" minWidth="240" maxWidth="240" spacing="0"
        style="-fx-background-color:#ffffff; -fx-border-color:#e5e7eb; -fx-border-width:0 1 0 0;">
    <VBox style="-fx-padding:22 18 18 18; -fx-spacing:4; -fx-border-color:#e5e7eb; -fx-border-width:0 0 1 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="GL" style="-fx-background-color:#059669; -fx-text-fill:white; -fx-font-size:13px; -fx-font-weight:800; -fx-background-radius:8; -fx-min-width:36; -fx-min-height:36; -fx-max-width:36; -fx-max-height:36; -fx-alignment:CENTER;"/>
        <VBox spacing="1">
          <Label text="GreenLedger" style="-fx-font-size:14px; -fx-font-weight:800; -fx-text-fill:#064e3b;"/>
          <Label text="Porteur de Projet" style="-fx-font-size:9px; -fx-text-fill:#059669; -fx-font-weight:600;"/>
        </VBox>
      </HBox>
    </VBox>
    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="PRINCIPAL" style="-fx-font-size:9px; -fx-font-weight:700; -fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Tableau de bord" onAction="#onDashboard"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
      <Button text="  Projets" onAction="#onProjets"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:#f0fdf4; -fx-text-fill:#059669; -fx-font-size:12px; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0 0 0 3; -fx-border-color:#059669; -fx-background-insets:0; -fx-effect:none;"/>
      <Button text="  Wallet" onAction="#onWallet"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
      <Button text="  Financement" onAction="#onFinancement"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
    </VBox>
    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="MARCHÉ &amp; OUTILS" style="-fx-font-size:9px; -fx-font-weight:700; -fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Marché" onAction="#onMarketplace"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
      <Button text="  Blockchain" onAction="#onBlockchain"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
      <Button text="  Outils" onAction="#onOutils"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
    </VBox>
    <VBox style="-fx-padding:14 14 6 14;">
      <Label text="COMPTE" style="-fx-font-size:9px; -fx-font-weight:700; -fx-text-fill:#9ca3af;"/>
    </VBox>
    <VBox spacing="2" style="-fx-padding:0 10 0 10;">
      <Button text="  Assistant IA" onAction="#onAssistant"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
      <Button text="  Profil" onAction="#onProfile"
              maxWidth="Infinity" alignment="CENTER_LEFT"
              style="-fx-background-color:transparent; -fx-text-fill:#374151; -fx-font-size:12px; -fx-font-weight:500; -fx-background-radius:8; -fx-padding:11 14; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
    </VBox>
    <Region VBox.vgrow="ALWAYS"/>
    <VBox style="-fx-background-color:#f9fafb; -fx-padding:14; -fx-spacing:10; -fx-border-color:#e5e7eb; -fx-border-width:1 0 0 0;">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="P" style="-fx-background-color:#dcfce7; -fx-text-fill:#059669; -fx-font-size:12px; -fx-font-weight:800; -fx-background-radius:20; -fx-min-width:38; -fx-min-height:38; -fx-max-width:38; -fx-max-height:38; -fx-alignment:CENTER;"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
          <Label fx:id="lblProfileName" style="-fx-font-size:12px; -fx-font-weight:700; -fx-text-fill:#111827;"/>
          <Label fx:id="lblProfileType" style="-fx-font-size:9px; -fx-text-fill:#059669;"/>
        </VBox>
      </HBox>
      <HBox spacing="6">
        <Button text="Profil" onAction="#onProfile" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color:#f3f4f6; -fx-text-fill:#374151; -fx-font-size:11px; -fx-font-weight:600; -fx-background-radius:7; -fx-padding:7 10; -fx-cursor:hand; -fx-border-width:0; -fx-background-insets:0;"/>
        <Button text="Quitter" onAction="#onLogout"
                style="-fx-background-color:rgba(244,63,94,0.15);-fx-text-fill:#f43f5e;-fx-font-size:11px;-fx-font-weight:600;-fx-background-radius:7;-fx-padding:7 10;-fx-cursor:hand;-fx-border-color:rgba(244,63,94,0.3);-fx-border-width:1;-fx-background-insets:0;"/>
      </HBox>
    </VBox>
  </VBox>

  <!-- ═══ MAIN CONTENT ═══ -->
  <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color:#F8FAFC;">

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background:#F8FAFC;-fx-background-color:#F8FAFC;-fx-border-width:0;">
      <VBox spacing="20">
        <padding><Insets top="0" right="0" bottom="32" left="0"/></padding>

        <!-- ── HERO HEADER ── -->
        <VBox spacing="12"
              style="-fx-background-color:linear-gradient(to bottom right,#059669,#10b981,#14b8a6);-fx-padding:28 32 28 32;">
          <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
              <Label fx:id="lblProjetId" text="PROJET #—"
                     style="-fx-font-size:10px;-fx-font-weight:700;-fx-text-fill:rgba(255,255,255,0.7);"/>
              <Label fx:id="lblTitre" text="—"
                     style="-fx-font-size:24px;-fx-font-weight:800;-fx-text-fill:white;"/>
              <Label fx:id="lblDescription" text="—"
                     style="-fx-font-size:12px;-fx-text-fill:rgba(255,255,255,0.8);" wrapText="true"/>
              <HBox spacing="10">
                <Label fx:id="lblStatutBadge" text="DRAFT"
                       style="-fx-background-color:rgba(255,255,255,0.2);-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:700;-fx-background-radius:5;-fx-padding:4 10;"/>
                <Label fx:id="lblEsgBadge" text="Score ESG: —"
                       style="-fx-background-color:rgba(255,255,255,0.15);-fx-text-fill:white;-fx-font-size:10px;-fx-font-weight:700;-fx-background-radius:5;-fx-padding:4 10;"/>
              </HBox>
            </VBox>
          </HBox>
        </VBox>

        <VBox spacing="20">
          <padding><Insets top="4" right="32" bottom="0" left="32"/></padding>

          <!-- ── EVALUATION BANNER (shown when APPROVED) ── -->
          <VBox fx:id="evalBanner" spacing="8" managed="false" visible="false"
                style="-fx-background-color:#f0fdf4;-fx-border-color:#bbf7d0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 20;">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label text="✓" style="-fx-font-size:18px;-fx-text-fill:#059669;"/>
              <Label text="Évaluation Expert Complétée — Approuvé"
                     style="-fx-font-size:14px;-fx-font-weight:700;-fx-text-fill:#065f46;"/>
            </HBox>
            <Label text="Votre projet a été évalué et approuvé par nos experts carbone."
                   style="-fx-font-size:12px;-fx-text-fill:#047857;"/>
          </VBox>

          <!-- ── 4 KPI CARDS ── -->
          <HBox spacing="16">
            <!-- Score ESG -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="6">
              <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
              <Label text="SCORE ESG" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
              <Label fx:id="lblScoreEsg" text="—"
                     style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#059669;"/>
              <Label text="/10" style="-fx-font-size:11px;-fx-text-fill:#94A3B8;"/>
            </VBox>
            <!-- Avoided CO2 -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="6">
              <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
              <Label text="ÉMISSIONS CO₂" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
              <Label fx:id="lblAvoidedCo2" text="—"
                     style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
              <Label text="tCO₂" style="-fx-font-size:11px;-fx-text-fill:#94A3B8;"/>
            </VBox>
            <!-- ML Decision -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="6">
              <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
              <Label text="DÉC. PAR ML" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
              <Label fx:id="lblMlDecision" text="—"
                     style="-fx-font-size:20px;-fx-font-weight:800;-fx-text-fill:#059669;"/>
            </VBox>
            <!-- Fraud risk -->
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="6">
              <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
              <Label text="RISQUE FRAUDE" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
              <Label fx:id="lblFraudRisk" text="—"
                     style="-fx-font-size:28px;-fx-font-weight:800;-fx-text-fill:#f59e0b;"/>
              <Label text="/ OK" style="-fx-font-size:11px;-fx-text-fill:#94A3B8;"/>
            </VBox>
          </HBox>

          <!-- ── RECOMMENDATIONS ── -->
          <VBox fx:id="recoBox" spacing="10" managed="false" visible="false"
                style="-fx-background-color:#fffbeb;-fx-border-color:#fde68a;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 20;">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="💡" style="-fx-font-size:14px;"/>
              <Label text="Recommandations"
                     style="-fx-font-size:13px;-fx-font-weight:700;-fx-text-fill:#92400e;"/>
            </HBox>
            <VBox fx:id="recoList" spacing="6"/>
          </VBox>

          <!-- ── COMPLETENESS ── -->
          <VBox styleClass="stat-card" spacing="10">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
            <HBox alignment="CENTER_LEFT">
              <Label text="Complétude du Projet"
                     style="-fx-font-size:14px;-fx-font-weight:700;-fx-text-fill:#0F172A;"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblCompleteness" text="—%"
                     style="-fx-font-size:16px;-fx-font-weight:800;-fx-text-fill:#059669;"/>
            </HBox>
            <Label fx:id="lblCompletenessDetail" text="— champs remplis sur 19"
                   style="-fx-font-size:11px;-fx-text-fill:#64748B;"/>
            <ProgressBar fx:id="progressCompleteness" progress="0" maxWidth="Infinity"
                         style="-fx-accent:#059669;-fx-pref-height:8;-fx-background-color:#E2E8F0;-fx-background-radius:4;"/>
          </VBox>

          <!-- ── FINANCING SECTION ── -->
          <VBox fx:id="financingBox" spacing="10" managed="false" visible="false"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="💰" style="-fx-font-size:14px;"/>
              <Label text="Projet financé"
                     style="-fx-font-size:13px;-fx-font-weight:700;-fx-text-fill:#059669;"/>
            </HBox>
            <HBox spacing="40">
              <VBox spacing="4">
                <Label text="MONTANT INVESTI" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
                <Label fx:id="lblMontantDemande" text="—"
                       style="-fx-font-size:22px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
              </VBox>
              <VBox spacing="4">
                <Label text="FINANCÉ LE" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
                <Label fx:id="lblFundedAt" text="—"
                       style="-fx-font-size:22px;-fx-font-weight:800;-fx-text-fill:#0F172A;"/>
              </VBox>
              <VBox spacing="4">
                <Label text="CRÉDITS ESTIMÉS" style="-fx-font-size:9px;-fx-font-weight:700;-fx-text-fill:#94A3B8;"/>
                <Label fx:id="lblEstimatedCredits" text="—"
                       style="-fx-font-size:22px;-fx-font-weight:800;-fx-text-fill:#059669;"/>
              </VBox>
            </HBox>
          </VBox>

          <!-- ── MAP ── -->
          <VBox spacing="10"
                style="-fx-background-color:white;-fx-border-color:#E2E8F0;-fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;-fx-padding:16 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,1);">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="📍" style="-fx-font-size:14px;"/>
              <Label text="Localisation du Projet"
                     style="-fx-font-size:13px;-fx-font-weight:700;-fx-text-fill:#0F172A;"/>
              <Region HBox.hgrow="ALWAYS"/>
              <Label fx:id="lblLocalisation" text="—"
                     style="-fx-font-size:11px;-fx-text-fill:#64748B;"/>
            </HBox>
            <WebView fx:id="mapWebView" prefHeight="220"/>
            <Label fx:id="lblAqi" text=""
                   style="-fx-font-size:12px;-fx-text-fill:#374151;-fx-padding:6 0 0 0;"
                   managed="false" visible="false"/>
          </VBox>

          <!-- ── ACTION BUTTONS ── -->
          <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="← Retour à la liste" onAction="#onProjets"
                    style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:10 18;-fx-cursor:hand;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-insets:0;"/>
            <Button fx:id="btnModifier" text="✏ Modifier le projet" onAction="#onModifier"
                    style="-fx-background-color:linear-gradient(to bottom right,#059669,#047857);-fx-text-fill:white;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:10 18;-fx-cursor:hand;-fx-border-width:0;-fx-background-insets:0;"/>
            <Button fx:id="btnExportPdf" text="📄 Exporter PDF" onAction="#onExportPdf"
                    style="-fx-background-color:#F8FAFC;-fx-text-fill:#334155;-fx-font-size:12px;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:10 18;-fx-cursor:hand;-fx-border-color:#CBD5E1;-fx-border-width:1;-fx-background-insets:0;"/>
            <Button fx:id="btnSubmit" text="📤 Soumettre" onAction="#onSubmit"
                    style="-fx-background-color:#FEF3C7;-fx-text-fill:#92400E;-fx-font-size:12px;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:10 18;-fx-cursor:hand;-fx-border-color:#FDE68A;-fx-border-width:1;-fx-background-insets:0;"
                    managed="false" visible="false"/>
          </HBox>

        </VBox>
      </VBox>
    </ScrollPane>
  </VBox>
</HBox>
